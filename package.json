{
  "name": "foliplus",
  "private": true,
  "type": "module",
  "imports": {
    "#common/*": "./foliplus/js/common/*",
    "#core/*": "./foliplus/js/core/*",
    "#foliplus/*": "./foliplus/js/*"
  },
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "scripts": {
    "build": "node script/build.mjs",
    "build:dev": "node script/build.mjs --dev",
    "build:check": "node script/build.mjs --check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/chroma-js": "^3.1.2",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.24.0",
    "h3-js": "^4.5.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "postcss-nesting": "^14.0.1",
    "prettier": "^3.9.5",
    "svgo": "^4.0.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
