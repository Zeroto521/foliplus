{
  "name": "foliplus",
  "private": true,
  "packageManager": "npm@11.13.0",
  "type": "module",
  "imports": {
    "#platform/*": "./foliplus/js/platform/*",
    "#core/*": "./foliplus/js/core/*",
    "#ui/*": "./foliplus/js/ui/*",
    "#control/*": "./foliplus/js/control/*",
    "#foliplus/*": "./foliplus/js/*",
    "#script/*": "./script/*"
  },
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "scripts": {
    "build": "node script/build/build.mjs",
    "build:dev": "node script/build/build.mjs --dev",
    "build:verify": "node script/build/build.mjs --verify",
    "build:sonda": "node script/build/build.mjs --sonda",
    "new-control": "node script/tool/new-control.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && node script/typecheck-test.mjs",
    "typecheck:tests": "vitest run --config vitest.config.mjs test/js/tsconfig.test.ts",
    "lint": "node script/check/event-name.mjs && node script/check/duplicate-class-def.mjs --check && node script/check/form-class-literal.mjs && node script/check/core-class-literal.mjs --check && node script/check/class-owner.mjs --check && node script/check/style-mode-usage.mjs --check && node script/check/style-mode-usage.mjs --check-legacy-alias && eslint -c config/eslint/typed.mjs \"foliplus/js/**/*.ts\" \"test/js/**/*.ts\" \"script/**/*.mjs\" \"config/**/*.mjs\" \"eslint.config.js\"",
    "format:check": "prettier --check \"foliplus/js/**/*.{js,ts}\" \"foliplus/css/**/*.css\" \"script/**/*.{js,cjs,mjs,ts}\" \"test/js/**/*.{js,ts}\" \"config/**/*.mjs\" \"eslint.config.js\"",
    "bundle-size:check": "node script/build/bundle-size-check.mjs",
    "bundle-size:fuse": "node script/build/bundle-fuse.mjs"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chroma-js": "^3.1.2",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/pako": "^3.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "geotiff": "^3.0.5",
    "h3-js": "^4.5.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^30.0.1",
    "leaflet": "1.9.4",
    "pako": "^3.0.2",
    "postcss": "^8.5.26",
    "postcss-nesting": "^14.0.1",
    "prettier": "^3.9.5",
    "sonda": "^0.14.0",
    "svgo": "^4.0.2",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.3"
  }
}
