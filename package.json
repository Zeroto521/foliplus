{
  "name": "foliplus",
  "private": true,
  "type": "module",
  "imports": {
    "#common/*": "./foliplus/js/common/*",
    "#foliplus/*": "./foliplus/js/*"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node script/build.mjs",
    "build:dev": "node script/build.mjs --dev",
    "build:check": "node script/build.mjs --check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.24.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "svgo": "^4.0.2"
  },
  "prettier": {
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 88,
    "tabWidth": 2,
    "singleAttributePerLine": false,
    "useTabs": false,
    "semi": true,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "htmlWhitespaceSensitivity": "css",
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^[.]"
    ],
    "importOrderSeparation": false,
    "importOrderSortSpecifiers": true
  }
}
