{
  // Typecheck program for the test suite. Same strictness as the production
  // program (inherited from ../../tsconfig.json) — tests are NOT exempt.
  //
  // Run `npm run typecheck:tests`. This program is red and is therefore wired
  // into CI with `continue-on-error: true` (see .github/workflows/test.yaml)
  // until the errors below are cleared. Once the count reaches zero the
  // `continue-on-error` line is dropped and the job becomes a hard gate.
  // Measured 2026-09-26 (after the first clearing batch, PR #469): ~1591
  // errors of which ~1164 are implicit-any cascades (TS7005/7006/7015/7031/
  // 7034/7053/18046/18047/18048) and ~427 are real mismatches
  // (TS2339/2345/2322/2352/2493/2348/2740/...). The counts are kept
  // deliberately approximate — they move with every test added — but the
  // *shape* is the contract: the vast majority is cascading implicit any from
  // a mock-heavy surface (vi.fn() without type args, `{}` stub objects,
  // partial fake events), not type-safety holes. Lifting the gate means
  // typing those, not relaxing anything here.
  //
  // The differences from the production program are all about what the tests
  // need to compile at all: `node` types for the script/ fixtures that touch
  // fs/path, `#script/*` for the build-script tests, and an allowJs include
  // scope so the ambient CONF/map declarations are picked up.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "#common/*": [
        "../../foliplus/js/common/*"
      ],
      "#core/*": [
        "../../foliplus/js/core/*"
      ],
      "#foliplus/*": [
        "../../foliplus/js/*"
      ],
      "#script/*": [
        "../../script/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../../foliplus/js/**/*.ts",
    "../../foliplus/js/type/global.d.ts"
  ]
}
