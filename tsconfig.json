{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  // This program covers only production sources. `test/js` has its own program
  // (test/js/tsconfig.json) which also runs `strict: true` — see that file for
  // the measured error count, and `npm run typecheck:tests` to reproduce it.
  // test/js is not part of `npm run typecheck` yet; the suite needs typing
  // work before it can gate CI.
  "include": [
    "foliplus/js/**/*.ts",
    "foliplus/js/**/*.d.ts"
  ]
}
